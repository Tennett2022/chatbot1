# ============================================================
# Crovenett Chatbot API — Variables de Entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
APP_NAME=Crovenett Chatbot API
API_VERSION=v1
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ─────────────────────────────────────────────
# SEGURIDAD / AUTENTICACIÓN
# ─────────────────────────────────────────────
# API Key para integraciones backend-to-backend (header: X-API-Key)
# Genera una clave larga y aleatoria, p. ej.: openssl rand -hex 32
API_KEY=

# JWT para frontends, paneles y apps propias
# Genera una clave segura: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440      # 24 horas

# ─────────────────────────────────────────────
# CORS — Orígenes permitidos (separados por coma)
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://crovenett.cl,https://www.crovenett.cl

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ─────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────
# Token del bot — obtener en https://t.me/BotFather
# Usado para operar el bot de Telegram (enviar/recibir mensajes)
TELEGRAM_BOT_TOKEN=
# Secreto para validar webhooks de Telegram (recomendado en producción)
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# WHATSAPP
# ─────────────────────────────────────────────
WHATSAPP_PROVIDER=meta       # meta | twilio | evolution | wati | zapi

# Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=              # Access Token de tu app en Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=    # ID del número de teléfono en Meta
WHATSAPP_VERIFY_TOKEN=       # Token personalizado para la verificación del webhook

# ─────────────────────────────────────────────
# LLM (Proveedor de Inteligencia Artificial)
# ─────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────
# SQLite (desarrollo):
DATABASE_URL=sqlite:///./crovenett_chatbot.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql://user:password@host:5432/crovenett_chatbot

# ─────────────────────────────────────────────
# NEGOCIO / ESCALACIÓN
# ─────────────────────────────────────────────
ESCALATION_EMAIL=contacto@crovenett.cl
ESCALATION_PHONE=+56 9 XXXX XXXX
MAX_HISTORY_MESSAGES=10
