# ============================================================
# Crovenett Chatbot — Variables de Entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# Entorno de la aplicación
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ─────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────
# Obtener en: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Token secreto para validar webhooks (opcional pero recomendado)
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# WHATSAPP
# ─────────────────────────────────────────────
# Proveedor: meta | twilio | evolution | wati | zapi
WHATSAPP_PROVIDER=meta

# Para Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=              # Access Token de la app en Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=    # ID del número de teléfono en Meta
WHATSAPP_VERIFY_TOKEN=       # Token personalizado para verificación del webhook

# ─────────────────────────────────────────────
# LLM (Proveedor de Inteligencia Artificial)
# ─────────────────────────────────────────────
# Proveedor activo: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini     # gpt-4o | gpt-4o-mini | gpt-4-turbo

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────
# SQLite (desarrollo): sqlite:///./crovenett_chatbot.db
# PostgreSQL (producción): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./crovenett_chatbot.db

# ─────────────────────────────────────────────
# NEGOCIO / ESCALACIÓN
# ─────────────────────────────────────────────
ESCALATION_EMAIL=contacto@crovenett.cl
ESCALATION_PHONE=+56 9 XXXX XXXX
MAX_HISTORY_MESSAGES=10
